# FFmpeg 与外部库的版本、来源、校验值。会被 ffmpeg/build.sh 引入。
# 升级版本只需要改这个文件；CI 的缓存键里包含它，改完会自动重新编译。
#
# 来源校验：
#   - GitHub 上的库用「标签 + 提交哈希」双重固定。标签被改动、仓库被替换时，哈希对不上会直接报错。
#   - LAME 没有官方 git 仓库，用 tar 包 + SHA-256，并列了几个镜像（任何一个下载成功且校验通过即可）。
#
# 取某个标签对应的提交哈希（注意要取带 ^{} 的那一行，也就是 tag 指向的提交）：
#   git ls-remote --tags https://github.com/FFmpeg/FFmpeg.git 'n8.1.3*'

# ---- 工具链 ----------------------------------------------------------------
# CI 用的 NDK 版本（本地用 ANDROID_NDK_ROOT 指向任意 r23 或更新的 NDK 即可）。
NDK_VERSION="28.2.13676358"
# 编译时的目标 API 级别，与 app/build.gradle.kts 里的 minSdk 保持一致。
# （FFmpeg 的 iconv 需要 API 28+，所以不要调低。）
ANDROID_API=28

# ---- FFmpeg（LGPL-2.1+）-----------------------------------------------------
FFMPEG_TAG="n8.1.3"
FFMPEG_COMMIT="1041abdc962f4cc4f394aa8de9dc5236c0c3b9e7"
FFMPEG_GIT_URLS="https://github.com/FFmpeg/FFmpeg.git https://git.ffmpeg.org/ffmpeg.git"

# ---- LAME：MP3 编码（LGPL-2.0+）---------------------------------------------
LAME_VERSION="3.100"
LAME_SHA256="ddfe36cab873794038ae2c1210557ad34857a4b6bdc515785d1da9e175b1da1e"
LAME_URLS="https://archive.ubuntu.com/ubuntu/pool/main/l/lame/lame_3.100.orig.tar.gz https://deb.debian.org/debian/pool/main/l/lame/lame_3.100.orig.tar.gz https://downloads.sourceforge.net/project/lame/lame/3.100/lame-3.100.tar.gz"

# ---- Opus：Opus 编码（BSD-3-Clause）-----------------------------------------
OPUS_TAG="v1.6.1"
OPUS_COMMIT="22244de5a79bd1d6d623c32e72bf1954b56235be"
OPUS_GIT_URLS="https://github.com/xiph/opus.git"

# ---- Ogg / Vorbis：Vorbis 编码（BSD-3-Clause）-------------------------------
OGG_TAG="v1.3.6"
OGG_COMMIT="be05b13e98b048f0b5a0f5fa8ce514d56db5f822"
OGG_GIT_URLS="https://github.com/xiph/ogg.git"

VORBIS_TAG="v1.3.7"
VORBIS_COMMIT="0657aee69dec8508a0011f47f3b69d7538e9d262"
VORBIS_GIT_URLS="https://github.com/xiph/vorbis.git"

# ---- 体积 ------------------------------------------------------------------
# 1 = 编译时加 --enable-small：按体积优化（-Os），和以前用的预编译包一致，每个架构的 libffmpeg.so 更小，
#     代价是转码速度略慢；0 = 按速度优化（-O2）。本地想试另一种，可以 FFMPEG_SMALL=0 ffmpeg/build.sh <abi>。
FFMPEG_SMALL="${FFMPEG_SMALL:-1}"
