<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Camera flash for the flashlight and SOS tools. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera.flash" android:required="false" />
    <uses-feature android:name="android.hardware.camera.any" android:required="false" />

    <!-- Decibel meter reads the microphone. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!-- Vibrator tool. -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- Network info tool reads connectivity state. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- APK extractor lists all installed packages on Android 11+. -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" />

    <!-- Special-app installer (APKS / XAPK / APKM): commits split APKs through PackageInstaller,
         which needs the "install unknown apps" permission for this app. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!-- Format conversion reads media files via the file picker. -->
    <uses-permission android:name="android.permission.READ_MEDIA_VIDEO" />
    <uses-permission android:name="android.permission.READ_MEDIA_AUDIO" />

    <!-- Wallpaper extractor. WallpaperManager.getWallpaperFile():
         Android 12 and below -> READ_EXTERNAL_STORAGE (runtime permission);
         Android 13+          -> only MANAGE_EXTERNAL_STORAGE ("All files access") returns the real
                                 wallpaper; without it the system hands back the default wallpaper or throws. -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" android:maxSdkVersion="29" />
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" tools:ignore="ScopedStorage" />

    <!-- 弱网助手：VPN 代理、前台服务、通知和悬浮窗。 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <!-- 模拟来电：系统通话账户、电话状态、定时闹钟与通话音频。 -->
    <uses-permission android:name="android.permission.MANAGE_OWN_CALLS" />
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.ToolyBox"
        android:enableOnBackInvokedCallback="true"
        android:requestLegacyExternalStorage="true"
        android:manageSpaceActivity=".storage.ManageSpaceActivity"
        tools:targetApi="36">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:launchMode="singleTop"
            android:theme="@style/Theme.ToolyBox"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboardHidden"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        <!-- 「打开方式」：把本应用注册为 .apks / .xapk / .apkm 的打开器，打开后交给「安装特殊应用」。
             系统不认识这三种扩展名，所以分三类匹配：
               1) 按扩展名：文件管理器 / FileProvider 的 URI，路径以扩展名结尾（MIME 任意）；
               2) 同上但不声明 MIME：只带 file:// 或 content:// 却没有类型的调用方；
               3) 按 MIME：浏览器下载 / 系统「下载」给出的 content:// 路径不带扩展名，只能靠通用类型兜底，
                  代价是别的 zip / 未知类型文件的「打开方式」里也会出现本应用。
             pathSuffix 是 Android 12 才有的属性（任意扩展名深度都匹配），低版本忽略它，靠 pathPattern。 -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="content" />
                <data android:scheme="file" />
                <data android:host="*" />
                <data android:mimeType="*/*" />
                <data android:pathSuffix=".apks" tools:ignore="UnusedAttribute" />
                <data android:pathSuffix=".xapk" tools:ignore="UnusedAttribute" />
                <data android:pathSuffix=".apkm" tools:ignore="UnusedAttribute" />
                <data android:pathPattern=".*\\.apks" />
                <data android:pathPattern=".*\\..*\\.apks" />
                <data android:pathPattern=".*\\..*\\..*\\.apks" />
                <data android:pathPattern=".*\\..*\\..*\\..*\\.apks" />
                <data android:pathPattern=".*\\..*\\..*\\..*\\..*\\.apks" />
                <data android:pathPattern=".*\\..*\\..*\\..*\\..*\\..*\\.apks" />
                <data android:pathPattern=".*\\..*\\..*\\..*\\..*\\..*\\..*\\.apks" />
                <data android:pathPattern=".*\\..*\\..*\\..*\\..*\\..*\\..*\\..*\\.apks" />
                <data android:pathPattern=".*\\..*\\..*\\..*\\..*\\..*\\..*\\..*\\..*\\.apks" />
                <data android:pathPattern=".*\\..*\\..*\\..*\\..*\\..*\\..*\\..*\\..*\\..*\\.apks" />
                <data android:pathPattern=".*\\.xapk" />
                <data android:pathPattern=".*\\..*\\.xapk" />
                <data android:pathPattern=".*\\..*\\..*\\.xapk" />
                <data android:pathPattern=".*\\..*\\..*\\..*\\.xapk" />
                <data android:pathPattern=".*\\..*\\..*\\..*\\..*\\.xapk" />
                <data android:pathPattern=".*\\..*\\..*\\..*\\..*\\..*\\.xapk" />
                <data android:pathPattern=".*\\..*\\..*\\..*\\..*\\..*\\..*\\.xapk" />
                <data android:pathPattern=".*\\..*\\..*\\..*\\..*\\..*\\..*\\..*\\.xapk" />
                <data android:pathPattern=".*\\..*\\..*\\..*\\..*\\..*\\..*\\..*\\..*\\.xapk" />
                <data android:pathPattern=".*\\..*\\..*\\..*\\..*\\..*\\..*\\..*\\..*\\..*\\.xapk" />
                <data android:pathPattern=".*\\.apkm" />
                <data android:pathPattern=".*\\..*\\.apkm" />
                <data android:pathPattern=".*\\..*\\..*\\.apkm" />
                <data android:pathPattern=".*\\..*\\..*\\..*\\.apkm" />
                <data android:pathPattern=".*\\..*\\..*\\..*\\..*\\.apkm" />
                <data android:pathPattern=".*\\..*\\..*\\..*\\..*\\..*\\.apkm" />
                <data android:pathPattern=".*\\..*\\..*\\..*\\..*\\..*\\..*\\.apkm" />
                <data android:pathPattern=".*\\..*\\..*\\..*\\..*\\..*\\..*\\..*\\.apkm" />
                <data android:pathPattern=".*\\..*\\..*\\..*\\..*\\..*\\..*\\..*\\..*\\.apkm" />
                <data android:pathPattern=".*\\..*\\..*\\..*\\..*\\..*\\..*\\..*\\..*\\..*\\.apkm" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="content" />
                <data android:scheme="file" />
                <data android:host="*" />
                <data android:pathSuffix=".apks" tools:ignore="UnusedAttribute" />
                <data android:pathSuffix=".xapk" tools:ignore="UnusedAttribute" />
                <data android:pathSuffix=".apkm" tools:ignore="UnusedAttribute" />
                <data android:pathPattern=".*\\.apks" />
                <data android:pathPattern=".*\\..*\\.apks" />
                <data android:pathPattern=".*\\..*\\..*\\.apks" />
                <data android:pathPattern=".*\\..*\\..*\\..*\\.apks" />
                <data android:pathPattern=".*\\..*\\..*\\..*\\..*\\.apks" />
                <data android:pathPattern=".*\\..*\\..*\\..*\\..*\\..*\\.apks" />
                <data android:pathPattern=".*\\..*\\..*\\..*\\..*\\..*\\..*\\.apks" />
                <data android:pathPattern=".*\\..*\\..*\\..*\\..*\\..*\\..*\\..*\\.apks" />
                <data android:pathPattern=".*\\..*\\..*\\..*\\..*\\..*\\..*\\..*\\..*\\.apks" />
                <data android:pathPattern=".*\\..*\\..*\\..*\\..*\\..*\\..*\\..*\\..*\\..*\\.apks" />
                <data android:pathPattern=".*\\.xapk" />
                <data android:pathPattern=".*\\..*\\.xapk" />
                <data android:pathPattern=".*\\..*\\..*\\.xapk" />
                <data android:pathPattern=".*\\..*\\..*\\..*\\.xapk" />
                <data android:pathPattern=".*\\..*\\..*\\..*\\..*\\.xapk" />
                <data android:pathPattern=".*\\..*\\..*\\..*\\..*\\..*\\.xapk" />
                <data android:pathPattern=".*\\..*\\..*\\..*\\..*\\..*\\..*\\.xapk" />
                <data android:pathPattern=".*\\..*\\..*\\..*\\..*\\..*\\..*\\..*\\.xapk" />
                <data android:pathPattern=".*\\..*\\..*\\..*\\..*\\..*\\..*\\..*\\..*\\.xapk" />
                <data android:pathPattern=".*\\..*\\..*\\..*\\..*\\..*\\..*\\..*\\..*\\..*\\.xapk" />
                <data android:pathPattern=".*\\.apkm" />
                <data android:pathPattern=".*\\..*\\.apkm" />
                <data android:pathPattern=".*\\..*\\..*\\.apkm" />
                <data android:pathPattern=".*\\..*\\..*\\..*\\.apkm" />
                <data android:pathPattern=".*\\..*\\..*\\..*\\..*\\.apkm" />
                <data android:pathPattern=".*\\..*\\..*\\..*\\..*\\..*\\.apkm" />
                <data android:pathPattern=".*\\..*\\..*\\..*\\..*\\..*\\..*\\.apkm" />
                <data android:pathPattern=".*\\..*\\..*\\..*\\..*\\..*\\..*\\..*\\.apkm" />
                <data android:pathPattern=".*\\..*\\..*\\..*\\..*\\..*\\..*\\..*\\..*\\.apkm" />
                <data android:pathPattern=".*\\..*\\..*\\..*\\..*\\..*\\..*\\..*\\..*\\..*\\.apkm" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="content" />
                <data android:mimeType="application/octet-stream" />
                <data android:mimeType="application/zip" />
                <data android:mimeType="application/x-zip-compressed" />
                <data android:mimeType="application/xapk-package-archive" />
            </intent-filter>
        </activity>

        <!-- 隐藏的分享转储器:在系统分享面板中接收任意 MIME 的文本或文件。 -->
        <activity
            android:name=".share.ShareReceiverActivity"
            android:exported="true"
            android:label="@string/share_dump_title"
            android:theme="@style/Theme.ToolyBox"
            android:excludeFromRecents="true"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboardHidden"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="*/*" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="*/*" />
            </intent-filter>
        </activity>

        <!-- 系统「应用信息 > 存储 > 管理空间」入口;展示应用各类目录占用并允许清理缓存。 -->
        <activity
            android:name=".storage.ManageSpaceActivity"
            android:exported="false"
            android:label="@string/manage_space_title"
            android:theme="@style/Theme.ToolyBox"
            android:excludeFromRecents="true"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboardHidden" />

        <!-- Video wallpaper engine: the system binds to it when the user sets
             this app as the wallpaper in the system wallpaper picker. -->
        <service
            android:name=".ui.wallpaper.VideoWallpaperService"
            android:permission="android.permission.BIND_WALLPAPER"
            android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.service.wallpaper.WallpaperService" />
            </intent-filter>
            <meta-data
                android:name="android.service.wallpaper"
                android:resource="@xml/video_wallpaper" />
        </service>

        <!-- 米游记录获取：前台监听 logcat，等待游戏输出抽卡记录链接。 -->
        <service
            android:name=".gacha.GachaLinkService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="gacha_link_watcher" />
        </service>

        <!-- 隔空闪传后台收到配对请求时弹出的透明选择窗口。 -->
        <activity
            android:name=".flashdrop.PairRequestActivity"
            android:exported="false"
            android:theme="@style/Theme.ToolyBox.Transparent"
            android:excludeFromRecents="true"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboardHidden" />

        <!-- 后台任务保活:FFmpeg / 隔空闪传等任务运行时维持前台服务。 -->
        <service
            android:name=".background.BackgroundTaskService"
            android:exported="false"
            android:label="@string/background_task_service"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="background_tasks" />
        </service>

        <!-- 全局方向调节:不可见悬浮窗 + 前台服务锁定屏幕方向。 -->
        <service
            android:name=".system.OrientationOverlayService"
            android:exported="false"
            android:label="@string/orientation_overlay_service"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="orientation_overlay" />
        </service>

        <!-- 隐藏系统通知：通过通知使用权把选中的通知 snooze 数年，可本地恢复。 -->
        <service
            android:name=".notification.NotificationHiderService"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE"
            android:exported="true"
            android:label="通知管理">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <!-- 弱网助手：系统 VPN + 本地 HTTP 代理，前台服务期间保持运行。 -->
        <service
            android:name=".weaknet.WeakNetVpnService"
            android:permission="android.permission.BIND_VPN_SERVICE"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <intent-filter>
                <action android:name="android.net.VpnService" />
            </intent-filter>
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="weak_network_proxy" />
        </service>

        <!-- 模拟来电：系统 Telecom 绑定此 ConnectionService 显示来电。 -->
        <service
            android:name=".fakecall.FakeCallConnectionService"
            android:exported="true"
            android:permission="android.permission.BIND_TELECOM_CONNECTION_SERVICE">
            <intent-filter>
                <action android:name="android.telecom.ConnectionService" />
            </intent-filter>
        </service>

        <receiver
            android:name=".fakecall.FakeCallAlarmReceiver"
            android:exported="false" />

        <!-- Shizuku：「执行 Shell 指令」工具靠它拿到 shell 权限。
             Shizuku 服务启动后会通过这个 Provider 把 Binder 送进本应用。 -->
        <provider
            android:name="rikka.shizuku.ShizukuProvider"
            android:authorities="${applicationId}.shizuku"
            android:enabled="true"
            android:exported="true"
            android:multiprocess="false"
            android:permission="android.permission.INTERACT_ACROSS_USERS_FULL" />
    </application>
</manifest>
