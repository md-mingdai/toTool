<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Camera flash for the flashlight and SOS tools. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera.flash" android:required="false" />

    <!-- Decibel meter reads the microphone. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!-- Vibrator tool. -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- Network info tool reads connectivity state. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- APK extractor lists all installed packages on Android 11+. -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" />

    <!-- Special-app installer (APKS / XAPK / APKM): commits split APKs through PackageInstaller,
         which needs the "install unknown apps" permission for this app. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!-- Format conversion reads media files via the file picker. -->
    <uses-permission android:name="android.permission.READ_MEDIA_VIDEO" />
    <uses-permission android:name="android.permission.READ_MEDIA_AUDIO" />

    <!-- Wallpaper extractor. WallpaperManager.getWallpaperFile():
         Android 12 and below -> READ_EXTERNAL_STORAGE (runtime permission);
         Android 13+          -> only MANAGE_EXTERNAL_STORAGE ("All files access") returns the real
                                 wallpaper; without it the system hands back the default wallpaper or throws. -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" tools:ignore="ScopedStorage" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.ToolyBox"
        android:enableOnBackInvokedCallback="true"
        tools:targetApi="36">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:launchMode="singleTop"
            android:theme="@style/Theme.ToolyBox"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboardHidden"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        <!-- 「打开方式」：把本应用注册为 .apks / .xapk / .apkm 的打开器，打开后交给「安装特殊应用」。
             系统不认识这三种扩展名，所以分三类匹配：
               1) 按扩展名：文件管理器 / FileProvider 的 URI，路径以扩展名结尾（MIME 任意）；
               2) 同上但不声明 MIME：只带 file:// 或 content:// 却没有类型的调用方；
               3) 按 MIME：浏览器下载 / 系统「下载」给出的 content:// 路径不带扩展名，只能靠通用类型兜底，
                  代价是别的 zip / 未知类型文件的「打开方式」里也会出现本应用。
             pathSuffix 是 Android 12 才有的属性（任意扩展名深度都匹配），低版本忽略它，靠 pathPattern。 -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="content" />
                <data android:scheme="file" />
                <data android:host="*" />
                <data android:mimeType="*/*" />
                <data android:pathSuffix=".apks" tools:ignore="UnusedAttribute" />
                <data android:pathSuffix=".xapk" tools:ignore="UnusedAttribute" />
                <data android:pathSuffix=".apkm" tools:ignore="UnusedAttribute" />
                <data android:pathPattern=".*\\.apks" />
                <data android:pathPattern=".*\\..*\\.apks" />
                <data android:pathPattern=".*\\..*\\..*\\.apks" />
                <data android:pathPattern=".*\\..*\\..*\\..*\\.apks" />
                <data android:pathPattern=".*\\..*\\..*\\..*\\..*\\.apks" />
                <data android:pathPattern=".*\\..*\\..*\\..*\\..*\\..*\\.apks" />
                <data android:pathPattern=".*\\..*\\..*\\..*\\..*\\..*\\..*\\.apks" />
                <data android:pathPattern=".*\\..*\\..*\\..*\\..*\\..*\\..*\\..*\\.apks" />
                <data android:pathPattern=".*\\..*\\..*\\..*\\..*\\..*\\..*\\..*\\..*\\.apks" />
                <data android:pathPattern=".*\\..*\\..*\\..*\\..*\\..*\\..*\\..*\\..*\\..*\\.apks" />
                <data android:pathPattern=".*\\.xapk" />
                <data android:pathPattern=".*\\..*\\.xapk" />
                <data android:pathPattern=".*\\..*\\..*\\.xapk" />
                <data android:pathPattern=".*\\..*\\..*\\..*\\.xapk" />
                <data android:pathPattern=".*\\..*\\..*\\..*\\..*\\.xapk" />
                <data android:pathPattern=".*\\..*\\..*\\..*\\..*\\..*\\.xapk" />
                <data android:pathPattern=".*\\..*\\..*\\..*\\..*\\..*\\..*\\.xapk" />
                <data android:pathPattern=".*\\..*\\..*\\..*\\..*\\..*\\..*\\..*\\.xapk" />
                <data android:pathPattern=".*\\..*\\..*\\..*\\..*\\..*\\..*\\..*\\..*\\.xapk" />
                <data android:pathPattern=".*\\..*\\..*\\..*\\..*\\..*\\..*\\..*\\..*\\..*\\.xapk" />
                <data android:pathPattern=".*\\.apkm" />
                <data android:pathPattern=".*\\..*\\.apkm" />
                <data android:pathPattern=".*\\..*\\..*\\.apkm" />
                <data android:pathPattern=".*\\..*\\..*\\..*\\.apkm" />
                <data android:pathPattern=".*\\..*\\..*\\..*\\..*\\.apkm" />
                <data android:pathPattern=".*\\..*\\..*\\..*\\..*\\..*\\.apkm" />
                <data android:pathPattern=".*\\..*\\..*\\..*\\..*\\..*\\..*\\.apkm" />
                <data android:pathPattern=".*\\..*\\..*\\..*\\..*\\..*\\..*\\..*\\.apkm" />
                <data android:pathPattern=".*\\..*\\..*\\..*\\..*\\..*\\..*\\..*\\..*\\.apkm" />
                <data android:pathPattern=".*\\..*\\..*\\..*\\..*\\..*\\..*\\..*\\..*\\..*\\.apkm" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="content" />
                <data android:scheme="file" />
                <data android:host="*" />
                <data android:pathSuffix=".apks" tools:ignore="UnusedAttribute" />
                <data android:pathSuffix=".xapk" tools:ignore="UnusedAttribute" />
                <data android:pathSuffix=".apkm" tools:ignore="UnusedAttribute" />
                <data android:pathPattern=".*\\.apks" />
                <data android:pathPattern=".*\\..*\\.apks" />
                <data android:pathPattern=".*\\..*\\..*\\.apks" />
                <data android:pathPattern=".*\\..*\\..*\\..*\\.apks" />
                <data android:pathPattern=".*\\..*\\..*\\..*\\..*\\.apks" />
                <data android:pathPattern=".*\\..*\\..*\\..*\\..*\\..*\\.apks" />
                <data android:pathPattern=".*\\..*\\..*\\..*\\..*\\..*\\..*\\.apks" />
                <data android:pathPattern=".*\\..*\\..*\\..*\\..*\\..*\\..*\\..*\\.apks" />
                <data android:pathPattern=".*\\..*\\..*\\..*\\..*\\..*\\..*\\..*\\..*\\.apks" />
                <data android:pathPattern=".*\\..*\\..*\\..*\\..*\\..*\\..*\\..*\\..*\\..*\\.apks" />
                <data android:pathPattern=".*\\.xapk" />
                <data android:pathPattern=".*\\..*\\.xapk" />
                <data android:pathPattern=".*\\..*\\..*\\.xapk" />
                <data android:pathPattern=".*\\..*\\..*\\..*\\.xapk" />
                <data android:pathPattern=".*\\..*\\..*\\..*\\..*\\.xapk" />
                <data android:pathPattern=".*\\..*\\..*\\..*\\..*\\..*\\.xapk" />
                <data android:pathPattern=".*\\..*\\..*\\..*\\..*\\..*\\..*\\.xapk" />
                <data android:pathPattern=".*\\..*\\..*\\..*\\..*\\..*\\..*\\..*\\.xapk" />
                <data android:pathPattern=".*\\..*\\..*\\..*\\..*\\..*\\..*\\..*\\..*\\.xapk" />
                <data android:pathPattern=".*\\..*\\..*\\..*\\..*\\..*\\..*\\..*\\..*\\..*\\.xapk" />
                <data android:pathPattern=".*\\.apkm" />
                <data android:pathPattern=".*\\..*\\.apkm" />
                <data android:pathPattern=".*\\..*\\..*\\.apkm" />
                <data android:pathPattern=".*\\..*\\..*\\..*\\.apkm" />
                <data android:pathPattern=".*\\..*\\..*\\..*\\..*\\.apkm" />
                <data android:pathPattern=".*\\..*\\..*\\..*\\..*\\..*\\.apkm" />
                <data android:pathPattern=".*\\..*\\..*\\..*\\..*\\..*\\..*\\.apkm" />
                <data android:pathPattern=".*\\..*\\..*\\..*\\..*\\..*\\..*\\..*\\.apkm" />
                <data android:pathPattern=".*\\..*\\..*\\..*\\..*\\..*\\..*\\..*\\..*\\.apkm" />
                <data android:pathPattern=".*\\..*\\..*\\..*\\..*\\..*\\..*\\..*\\..*\\..*\\.apkm" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="content" />
                <data android:mimeType="application/octet-stream" />
                <data android:mimeType="application/zip" />
                <data android:mimeType="application/x-zip-compressed" />
                <data android:mimeType="application/xapk-package-archive" />
            </intent-filter>
        </activity>

        <!-- Video wallpaper engine: the system binds to it when the user sets
             this app as the wallpaper in the system wallpaper picker. -->
        <service
            android:name=".ui.wallpaper.VideoWallpaperService"
            android:permission="android.permission.BIND_WALLPAPER"
            android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.service.wallpaper.WallpaperService" />
            </intent-filter>
            <meta-data
                android:name="android.service.wallpaper"
                android:resource="@xml/video_wallpaper" />
        </service>

        <!-- Shizuku：「执行 Shell 指令」工具靠它拿到 shell 权限。
             Shizuku 服务启动后会通过这个 Provider 把 Binder 送进本应用。 -->
        <provider
            android:name="rikka.shizuku.ShizukuProvider"
            android:authorities="${applicationId}.shizuku"
            android:enabled="true"
            android:exported="true"
            android:multiprocess="false"
            android:permission="android.permission.INTERACT_ACROSS_USERS_FULL" />
    </application>
</manifest>
